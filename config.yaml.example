# config.yaml.example
# Copy this file to config.yaml and fill in the paths for your machine.
# config.yaml is gitignored — never commit it (it contains server-specific paths).

paths:
  # Root of the raw DICOM data directory
  data_root: "/data1/Dicom Data"
  # Where converted NIfTI volumes will be written
  output_dir: "/data1/Processed_NIfTI"

# Parameters for the single-subject test run (dicomToNifti.py)
test_subject:
  week: "Week 12"
  tracer: "18F-FDG"
  subject_id: "m54253"

# File-size heuristics for modality identification (per PI).
# Sizes are in kilobytes; tolerance is a fraction (0.05 = ±5%).
file_size_heuristics:
  tolerance: 0.05
  pet_kb: 115
  ct_hi_res_kb: 2814
  ct_lo_res_kb: 705
